# Produits de compilation de Cargo
/target/

# Cargo.lock est versionné : l'espace de travail produit des exécutables.

# Corpus publics téléchargés par corpus/fetch.sh : jamais versionnés.
/corpus/cache/

# Corpus maison qui ne se publie pas : reste sur le poste.
/corpus/local/
/corpus/layouts/

# Planche et rapport du banc, régénérés par `foregram-bench board`.
/corpus/board/
