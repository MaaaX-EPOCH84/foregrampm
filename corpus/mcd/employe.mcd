#
# Écrit à la main d'après un cas relevé sur les modèles de maaax.com : une
# association qui relie une entité à elle-même, soit deux liens parallèles
# entre les deux mêmes nœuds. EMPLOYE en porte deux, dont une avec des
# propriétés, et deux associations ordinaires vers SERVICE.

entite EMPLOYE
  #matricule
  nom
  prenom
  date_embauche

entite SERVICE
  #code_service
  libelle

association ENCADRER
  EMPLOYE 0,n
  EMPLOYE 0,1

association REMPLACER
  date_debut
  date_fin
  EMPLOYE 0,n
  EMPLOYE 0,n

association AFFECTER
  EMPLOYE 1,1
  SERVICE 0,n

association DIRIGER
  EMPLOYE 0,1
  SERVICE 1,1
